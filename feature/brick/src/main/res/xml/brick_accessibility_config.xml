<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground-app watcher for Brick (§Module Brick). Only window-state changes
  are requested (the cheapest event that names the front app); no content is
  read, nothing is logged off-device.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/brick_service_description"
    android:notificationTimeout="50" />
