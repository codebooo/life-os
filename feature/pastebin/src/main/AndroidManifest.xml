<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
            Single share target for text and links. Translucent + excludeFromRecents
            so the card floats over the app the text came from instead of opening
            LifeOS (§Module Pastebin).
        -->
        <activity
            android:name="com.lifeos.feature.pastebin.share.ShareRouterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="Share to LifeOS"
            android:theme="@style/Theme.LifeOs.ShareOverlay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
