<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Notification capture (§Module Signals). Bound only after the user
            grants notification access in system settings; nothing is captured
            before that, and nothing leaves the phone.
        -->
        <service
            android:name="com.lifeos.feature.signals.data.SignalListenerService"
            android:exported="true"
            android:label="LifeOS Signals"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
